{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2023",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "./build",
    "baseUrl": "./src",
    "paths": {
      "@controllers/*": [
        "./controllers/*"
      ],
      "@database/*": [
        "./database/*"
      ],
      "@middlewares/*": [
        "./middlewares/*"
      ],
      "@repositories/*": [
        "./repositories/*"
      ],
      "@routes/*": [
        "./routes/*"
      ],
      "@schemas/*": [
        "./schemas/*"
      ],
      "@services/*": [
        "./services/*"
      ],
      "@utils/*": [
        "./utils/*"
      ],
      "@types/*": [
        "./types/*"
      ]
    },
    "types": [
      "node"
    ],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmitOnError": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules"
  ]
}