# ============================================================
# Controle de Horas Backend — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA versione o arquivo .env no repositório.
# ============================================================

# ── Servidor ─────────────────────────────────────────────────
APP_HOST=localhost
APP_PORT=3000

# ── Banco de Dados (PostgreSQL) ──────────────────────────────
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL="postgresql://postgres:senha@localhost:5432/controle_horas"

# ── JWT — Access Token ───────────────────────────────────────
# Mínimo de 32 caracteres. Use: openssl rand -hex 32
JWT_SECRET="substitua_por_uma_chave_segura_de_pelo_menos_32_chars"

# Formato aceito: 30s | 15m | 1h | 7d  (padrão: 30m)
JWT_EXPIRES_IN="30m"

# ── JWT — Refresh Token ──────────────────────────────────────
# Use uma chave DIFERENTE do JWT_SECRET. Use: openssl rand -hex 32
JWT_REFRESH_SECRET="substitua_por_outra_chave_segura_diferente_da_anterior"

# Formato aceito: 30s | 15m | 1h | 7d  (padrão: 7d)
JWT_REFRESH_EXPIRES_IN="7d"