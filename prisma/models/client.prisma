enum StatusClient {
  ATIVO
  INATIVO
}

model Client {
  clientId  Int          @id @default(autoincrement())
  name      String
  email     String       @unique
  ein       String       @unique
  status    StatusClient @default(ATIVO)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  projects Projects[]

  @@map("clients")
}
