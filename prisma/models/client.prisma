enum StatusClient {
  ATIVO
  INATIVO
}

model Client {
  clientId  Int          @id @default(autoincrement())
  name      String
  email     String?
  ein       String?
  status    StatusClient @default(ATIVO)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("clients")
}
